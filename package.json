{
  "name": "barbervision",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3000",
    "lint": "eslint .",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:lint": "supabase db lint --local",
    "db:test": "supabase test db",
    "db:test:concurrency": "node --env-file-if-exists=.env.local scripts/test-db-concurrency.mjs",
    "db:test:integration": "node --env-file-if-exists=.env.local scripts/test-supabase-jwt-storage.mjs",
    "test:e2e": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-e2e-local.ps1",
    "auth:provision-owner": "node --env-file-if-exists=.env.local scripts/provision-owner.mjs",
    "auth:recover-owner-totp": "node --env-file-if-exists=.env.local scripts/recover-owner-totp.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.35",
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.112.2",
    "lucide-react": "^0.383.0",
    "next": "16.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "autoprefixer": "^10.4.19",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.0",
    "pg": "^8.23.0",
    "postcss": "8.5.26",
    "supabase": "^2.115.0",
    "tailwindcss": "^3.4.4"
  }
}
