# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_sua-chave

# Somente no servidor. Nunca prefixe com NEXT_PUBLIC_ nem envie ao navegador.
SUPABASE_SECRET_KEY=sb_secret_sua-chave

# Origem exata usada nos links de convite/recuperação. HTTPS em produção.
BARBERVISION_APP_URL=http://127.0.0.1:3000
BARBERVISION_CRON_SECRET=

# Cloudflare Turnstile. A site key é pública; a secret fica somente no servidor.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
BARBERVISION_TURNSTILE_HOSTNAMES=barbervision.onrender.com

# Segredo aleatório opcional, com pelo menos 32 caracteres, para HMAC dos
# identificadores do rate limit. Se ausente/inválido, o servidor deriva um
# segredo separado da TURNSTILE_SECRET_KEY, sem armazenar IP ou contato em claro.
BARBERVISION_RATE_LIMIT_SECRET=

# Somente no Cloudflare Worker; webhook HTTPS opcional para alertas operacionais.
BARBERVISION_ALERT_WEBHOOK_URL=

# Rotas internas mockadas ficam bloqueadas por padrao em producao.
# Ative somente em uma demonstracao isolada. Isto nao cria autenticacao real.
BARBERVISION_ENABLE_UNSAFE_INTERNAL_DEMO=false

# Apenas para a suíte destrutiva/descartável de concorrência do banco.
# O runner usa esta URL local por padrão; nunca aponte para produção.
BARBERVISION_TEST_DATABASE_URL=postgresql://supabase_admin:postgres@127.0.0.1:54322/postgres
BARBERVISION_ALLOW_REMOTE_DB_TEST=false
BARBERVISION_TEST_DATABASE_CONFIRM=127.0.0.1:54322/postgres

# O runner tambem exige este comentario dentro do banco descartavel:
# COMMENT ON DATABASE postgres IS 'barbervision:disposable-concurrency-test';
